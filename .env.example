# Copy this file to .env, then use: set -a; source .env; set +a
# No external/cloud inference endpoints are allowed in iteration 1.
PII_LLM_BASE_URL=http://127.0.0.1:1234/v1
# Use GET http://127.0.0.1:1234/v1/models to discover the exact loaded ID.
PII_MODEL_ID=
PII_LLM_MODE=on-uncertain
# Optional: reuse a 24+ character bridge token between local UI restarts.
# Otherwise `python -m privacygate.web` creates and prints a fresh token.
PRIVACYGATE_BRIDGE_TOKEN=
